[Unit]
Description=Educative Viewer Compose Application
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Downloads/personal/educative/educative-viewer
Environment=DOCKER_HOST=unix:///run/user/%U/podman/podman.sock
# Remove any existing container from previous run
ExecStartPre=/usr/bin/docker rm -f educative-viewer || /bin/true
# Use docker compose (Podman backend) OR podman-compose
ExecStart=/usr/bin/docker compose up -d
ExecStartPost=/usr/bin/tailscale serve --bg 5001
ExecStop=/usr/bin/docker compose down
ExecStopPost=-/usr/bin/tailscale serve off
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=0

[Install]
WantedBy=default.target
